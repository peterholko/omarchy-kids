# Parent core hosts the independently installed school and time services.
[Unit]
Description=Omarchy parent module host
Documentation=https://github.com/peterholko/omarchy-kids
After=systemd-logind.service
Wants=systemd-logind.service

[Service]
Type=simple
Environment=OMARCHY_PATH=/usr/share/omarchy
ExecStart=/usr/bin/omarchy-kids-timed
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
RuntimeDirectory=omarchy-kids/screen-time
RuntimeDirectoryMode=0755
StateDirectory=omarchy/parent/screen-time
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
