# One collection of a child install's browsing history (plans/kids-browsing.md):
# new visits from the kid's browser history databases and the YouTube titles
# on screen, into root's log. Installed to /etc/systemd/system and run by
# omarchy-kids-browsing.timer while `omarchy-kids browsing` is on.
[Unit]
Description=Omarchy kids mode browsing history collection
ConditionPathExistsGlob=/var/lib/omarchy/parent/*/browsing/enabled

[Service]
Type=oneshot
ExecStart=/usr/bin/omarchy-kids-browsing collect
