#!/bin/bash

# omarchy:summary=Choose which apps the kid can open, allowlist or denylist
# omarchy:args=<status|list|denylist|allowlist|off|allow|deny|remove|apply> [APP ...]
# omarchy:examples=sudo omarchy-kids apps denylist | sudo omarchy-kids apps deny Steam | sudo omarchy-kids apps list
# omarchy:requires-sudo=true

# The app list of a child install (plans/kids-apps.md), reached as
# `omarchy-kids apps ...`. A blocked app's desktop entry loses its
# world-read bit, so the launcher no longer lists it, and its program loses
# its world-execute bit, so a terminal cannot start it; root sets both and
# puts them back, and a pacman hook re-applies the lists after a package
# transaction restores the packaged modes. Off until a parent turns it on.
#
# Runs as root; a bare invocation re-execs itself under sudo, whose prompt is
# the parent password itself, forwarding the caller's gum theme vars.

set -euo pipefail

usage() {
  cat <<USAGE
Usage: omarchy-kids apps [status|list]
       omarchy-kids apps <denylist|allowlist|off>
       omarchy-kids apps <allow|deny|remove> APP...
       omarchy-kids apps apply [--quiet]

denylist  Every app is available except the ones in the deny list. A child
          install starts here, with the list seeded: LocalSend, Moonlight,
          OBS Studio, the terminal's own entries, btop, Neovim, Disks, and
          the Avahi browsers; allow opens one when the time comes.
allowlist Only the apps in the allow list are; an app installed later stays
          hidden until allowed. Switching on with an empty allow list seeds
          it with every app installed today, so nothing hides by surprise.
allow, deny, remove
          Move apps between /etc/omarchy/parent/apps.allow and apps.deny,
          named as the launcher shows them (Steam) or by desktop id (steam,
          org.gnome.Nautilus); apply picks up a hand edit of those files.
list      Every app with its verdict. A program shared by several apps stays
          open while any of them is allowed; list says so.

The terminal is never closed: the menu's floating terminal is how a parent
runs omarchy-kids at all. Web apps are the browser, governed by the web
filter (omarchy-kids dns) and by whether the browser itself is allowed.
USAGE
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

if (( EUID != 0 )); then
  mapfile -t gum_env < <(env | grep '^GUM_' || true)
  exec sudo env "${gum_env[@]}" "$0" "$@"
fi

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"

fail() {
  echo "Error: $1" >&2
  exit 1
}

# Every system path hangs off SYSROOT so the shell test can run the functions
# against a scratch tree; the settings file comes from the shared helper.
SYSROOT="${OMARCHY_KIDS_SYSROOT:-}"
[[ -z $SYSROOT ]] || SYSROOT=$(readlink -f "$SYSROOT")
source "$OMARCHY_PATH/install/helpers/parent.sh"

APPS_OWNER="${OMARCHY_KIDS_APPS_OWNER:-root}"
PARENT_ETC="$SYSROOT/etc/omarchy/parent"
ALLOW_FILE="$PARENT_ETC/apps.allow"
DENY_FILE="$PARENT_ETC/apps.deny"
STATE_DIR="$SYSROOT/var/lib/omarchy/parent/apps"
RESTORE_FILE="$STATE_DIR/restore"
HOOK=omarchy-kids-apps.hook
HOOK_DIR="$SYSROOT/etc/pacman.d/hooks"
HOOK_SOURCE="$OMARCHY_PATH/default/parent/$HOOK"
NEVER_CLOSE="$OMARCHY_PATH/default/parent/apps-never-close.list"
SEED_DENY="$OMARCHY_PATH/default/parent/apps-child.deny"
APP_DIRS=("$SYSROOT/usr/share/applications" "$SYSROOT/usr/local/share/applications")
PROGRAM_DIRS=(usr/local/bin usr/bin bin)
PROGRAM_ROOTS=(/usr/bin /usr/local/bin /usr/lib /opt)
CHANGED=0

require_child_install() {
  omarchy-profile-child || fail "this is not a child install; the app list only applies to the kids mode profile"
}

# --- lists ---

read_list() {
  [[ -f $1 ]] || return 0
  sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" | grep -v '^$' | tr 'A-Z' 'a-z'
}

lower() {
  printf '%s\n' "$1" | tr 'A-Z' 'a-z'
}

list_header() {
  local file="$1" verb="$2"
  cat >"$file" <<HEADER
# Omarchy kids mode: apps the parent ${verb}s, one desktop id per line
# (steam, org.gnome.Nautilus), # for comments. Edit and run
# \`sudo omarchy-kids apps apply\`, or let \`sudo omarchy-kids apps ${verb} APP\`
# write here for you; \`sudo omarchy-kids apps list\` shows the ids.
HEADER
  chmod 644 "$file"
}

# A deny list that does not exist yet starts from the shipped child list; a
# parent's edits from then on are theirs, and off keeps the file.
seed_deny_list() {
  [[ -f $SEED_DENY ]] || return 0
  {
    echo "# A child install starts with these denied (from default/parent/apps-child.deny):"
    echo "# the apps a kid opens only with supervision, and the terminal's entries,"
    echo "# developer tools, and disks. \`sudo omarchy-kids apps allow NAME\` opens one."
    read_list "$SEED_DENY"
  } >>"$DENY_FILE"
}

ensure_lists() {
  mkdir -p "$PARENT_ETC"
  [[ -f $ALLOW_FILE ]] || list_header "$ALLOW_FILE" allow
  if [[ ! -f $DENY_FILE ]]; then
    list_header "$DENY_FILE" deny
    seed_deny_list
  fi
}

list_has() {
  read_list "$1" | grep -qxF "$(lower "$2")"
}

list_add() {
  local file="$1" id="$2"
  ensure_lists
  list_has "$file" "$id" || printf '%s\n' "$id" >>"$file"
}

list_drop() {
  local file="$1" id="$2" stage
  [[ -f $file ]] || return 0
  stage=$(mktemp)
  awk -v id="$(lower "$id")" '
    { line = $0; sub(/#.*/, "", line); gsub(/^[ \t]+|[ \t]+$/, "", line) }
    tolower(line) != id { print }
  ' "$file" >"$stage"
  install -m644 "$stage" "$file"
  rm -f "$stage"
}

list_count() {
  read_list "$1" | grep -c . || true
}

# --- desktop entries ---

file_mode() {
  stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"
}

file_owner() {
  stat -c %U "$1" 2>/dev/null || stat -f %Su "$1"
}

# The first value of KEY in the [Desktop Entry] group.
entry_field() {
  awk -v key="$2" -F= '
    /^\[/ { in_entry = ($0 == "[Desktop Entry]"); next }
    in_entry && $1 == key { sub(/^[^=]*=/, ""); print; exit }
  ' "$1"
}

entry_id() {
  local name=${1##*/}
  printf '%s\n' "${name%.desktop}"
}

entry_displayable() {
  local type
  type=$(entry_field "$1" Type)
  [[ ${type:-Application} == "Application" ]] || return 1
  [[ $(entry_field "$1" NoDisplay) != "true" && $(entry_field "$1" Hidden) != "true" ]]
}

# A program name or path from Exec=, resolved to the real file, and only
# when it is somewhere a package puts programs, belongs to root, and is not
# on the never-close list.
resolve_program() {
  local name="$1" candidate="" real rel dir root under=0
  if [[ $name == /* ]]; then
    candidate="$SYSROOT$name"
  else
    for dir in "${PROGRAM_DIRS[@]}"; do
      if [[ -f $SYSROOT/$dir/$name ]]; then
        candidate="$SYSROOT/$dir/$name"
        break
      fi
    done
  fi
  [[ -n $candidate && -f $candidate ]] || return 0
  real=$(readlink -f "$candidate") || return 0
  rel=${real#"$SYSROOT"}
  for root in "${PROGRAM_ROOTS[@]}"; do
    [[ $rel == "$root"/* ]] && under=1
  done
  (( under )) || return 0
  if read_list "$NEVER_CLOSE" | grep -qxF "$(lower "${real##*/}")"; then
    return 0
  fi
  [[ $(file_owner "$real") == "$APPS_OWNER" ]] || return 0
  printf '%s\n' "$real"
}

# The program an entry starts: the first word of Exec= after any env and
# VAR=value words, quotes aside.
entry_program() {
  local exec_line tok first=""
  exec_line=$(entry_field "$1" Exec)
  set -f
  for tok in $exec_line; do
    tok=${tok#\"}
    tok=${tok%\"}
    case "$tok" in
      env|[A-Za-z_]*=*) continue ;;
    esac
    first=$tok
    break
  done
  set +f
  [[ -n $first ]] || return 0
  resolve_program "$first"
}

# Every displayable entry, one per line: id, name, program, file; by name.
scan_entries() {
  local dir file id name program
  for dir in "${APP_DIRS[@]}"; do
    [[ -d $dir ]] || continue
    for file in "$dir"/*.desktop; do
      [[ -f $file ]] || continue
      entry_displayable "$file" || continue
      id=$(entry_id "$file")
      name=$(entry_field "$file" Name)
      program=$(entry_program "$file")
      printf '%s\t%s\t%s\t%s\n' "$id" "${name:-$id}" "$program" "$file"
    done
  done | sort -t "$(printf '\t')" -k2,2f
}

# A word the parent typed, as an id: an exact id or name first, then a
# single app whose id or name contains it.
resolve_app() {
  local word entries matches count
  word=$(lower "$1")
  entries=$(scan_entries)
  matches=$(awk -F '\t' -v w="$word" 'tolower($1) == w || tolower($2) == w { print $1 }' <<<"$entries")
  if [[ -z $matches ]]; then
    matches=$(awk -F '\t' -v w="$word" 'index(tolower($1), w) || index(tolower($2), w) { print $1 }' <<<"$entries")
  fi
  count=$(grep -c . <<<"$matches" || true)
  case "$count" in
    0) fail "no installed app matches '$1'; see: sudo omarchy-kids apps list" ;;
    1) printf '%s\n' "$matches" ;;
    *) fail "several apps match '$1' ($(tr '\n' ' ' <<<"$matches"| sed 's/ $//')); use one of those ids" ;;
  esac
}

# --- verdicts ---

apps_mode() {
  local mode
  mode=$(conf_get apps denylist)
  case "$mode" in
    off|denylist|allowlist) printf '%s\n' "$mode" ;;
    *)
      echo "Warning: apps=$mode in $PARENT_CONF is not off, denylist, or allowlist; treating it as denylist." >&2
      echo denylist
      ;;
  esac
}

entry_blocked() {
  local id="$1" mode="$2"
  case "$mode" in
    denylist) list_has "$DENY_FILE" "$id" ;;
    allowlist) list_has "$DENY_FILE" "$id" || ! list_has "$ALLOW_FILE" "$id" ;;
    *) return 1 ;;
  esac
}

# --- modes on disk ---

record_mode() {
  local path="$1"
  mkdir -p "$STATE_DIR"
  touch "$RESTORE_FILE"
  if awk -F '\t' -v p="$path" '$2 == p { found = 1 } END { exit !found }' "$RESTORE_FILE"; then
    return 0
  fi
  printf '%s\t%s\n' "$(file_mode "$path")" "$path" >>"$RESTORE_FILE"
}

recorded_mode() {
  [[ -f $RESTORE_FILE ]] || return 0
  awk -F '\t' -v p="$1" '$2 == p { print $1; exit }' "$RESTORE_FILE"
}

forget_mode() {
  local stage
  [[ -f $RESTORE_FILE ]] || return 0
  stage=$(mktemp)
  awk -F '\t' -v p="$1" '$2 != p' "$RESTORE_FILE" >"$stage"
  install -m644 "$stage" "$RESTORE_FILE"
  rm -f "$stage"
}

# A launcher watching the directory notices a file that is replaced, not one
# whose mode changed.
rewrite_in_place() {
  cp -p "$1" "$1.omarchy-kids" && mv -f "$1.omarchy-kids" "$1"
}

hide_entry() {
  local file="$1" mode
  mode=$(file_mode "$file")
  if (( 8#$mode & 4 )); then
    record_mode "$file"
    chmod o-r "$file"
    rewrite_in_place "$file"
    CHANGED=1
  fi
}

close_program() {
  local path="$1" mode
  mode=$(file_mode "$path")
  if (( 8#$mode & 1 )); then
    record_mode "$path"
    chmod o-rx "$path"
    CHANGED=1
  fi
}

restore_path() {
  local path="$1" mode
  mode=$(recorded_mode "$path")
  [[ -n $mode ]] || return 0
  if [[ -e $path ]]; then
    chmod "$mode" "$path"
    [[ $path == *.desktop ]] && rewrite_in_place "$path"
  fi
  forget_mode "$path"
  CHANGED=1
}

restore_all() {
  local records mode path
  [[ -f $RESTORE_FILE ]] || return 0
  records=$(<"$RESTORE_FILE")
  while IFS=$'\t' read -r mode path; do
    [[ -n $path ]] && restore_path "$path"
  done <<<"$records"
  rm -f "$RESTORE_FILE"
}

# Blocked entries hide; a program closes only when every entry that names
# it is blocked; whatever was recorded and not touched this pass is put back.
apply_lists() {
  local mode entries id name program file touched="" blocked_programs="" open_programs="" records path
  mode=$(apps_mode)
  if [[ $mode == "off" ]]; then
    restore_all
    return 0
  fi
  entries=$(scan_entries)
  while IFS=$'\t' read -r id name program file; do
    [[ -n $file ]] || continue
    touched+="$file"$'\n'
    if entry_blocked "$id" "$mode"; then
      hide_entry "$file"
      [[ -n $program ]] && blocked_programs+="$program"$'\n'
    else
      restore_path "$file"
      [[ -n $program ]] && open_programs+="$program"$'\n'
    fi
  done <<<"$entries"
  while read -r program; do
    [[ -n $program ]] || continue
    touched+="$program"$'\n'
    if grep -qxF "$program" <<<"$open_programs"; then
      restore_path "$program"
    else
      close_program "$program"
    fi
  done < <(printf '%s' "$blocked_programs" | sort -u)
  while read -r program; do
    [[ -n $program ]] || continue
    touched+="$program"$'\n'
    restore_path "$program"
  done < <(printf '%s' "$open_programs" | sort -u)
  [[ -f $RESTORE_FILE ]] || return 0
  records=$(<"$RESTORE_FILE")
  while IFS=$'\t' read -r mode path; do
    [[ -n $path ]] || continue
    grep -qxF "$path" <<<"$touched" && continue
    restore_path "$path"
  done <<<"$records"
}

# --- switching and reporting ---

document_key() {
  conf_document apps denylist \
    "apps: which apps the kid can open (sudo omarchy-kids apps)." \
    "  denylist   every app except /etc/omarchy/parent/apps.deny (default, seeded on a child install)" \
    "  allowlist  only /etc/omarchy/parent/apps.allow; a new install stays hidden until allowed" \
    "  off        every app"
}

install_hook() {
  mkdir -p "$HOOK_DIR"
  install -m644 "$HOOK_SOURCE" "$HOOK_DIR/$HOOK"
}

seed_allow_list() {
  local id name program file count=0
  while IFS=$'\t' read -r id name program file; do
    [[ -n $id ]] || continue
    list_has "$DENY_FILE" "$id" && continue
    list_add "$ALLOW_FILE" "$id"
    count=$((count + 1))
  done < <(scan_entries)
  echo "Allow list seeded with the $count apps installed today; deny or remove what she should not have, and allow what you install later."
}

hook_in_place() {
  [[ -f $HOOK_DIR/$HOOK ]]
}

status() {
  local mode blocked=0 total=0 id name program file
  mode=$(apps_mode)
  if [[ $mode == "off" ]]; then
    echo "Apps: every app is available ($(list_count "$ALLOW_FILE") allowed, $(list_count "$DENY_FILE") denied in the lists). Turn the list on with: sudo omarchy-kids apps denylist, or allowlist."
    return 0
  fi
  while IFS=$'\t' read -r id name program file; do
    [[ -n $id ]] || continue
    total=$((total + 1))
    entry_blocked "$id" "$mode" && blocked=$((blocked + 1))
  done < <(scan_entries)
  echo "Apps: $mode, $blocked of $total apps blocked ($(list_count "$ALLOW_FILE") allowed, $(list_count "$DENY_FILE") denied in the lists)."
  if hook_in_place; then
    echo "Package updates re-apply the list."
  else
    echo "Package updates would NOT re-apply the list; run: sudo omarchy-kids apps apply"
  fi
}

show_list() {
  local mode entries id name program file verdict sharer
  mode=$(apps_mode)
  entries=$(scan_entries)
  echo "Mode: $mode"
  printf '  %-30s %-30s %s\n' "App" "Id" "Verdict"
  while IFS=$'\t' read -r id name program file; do
    [[ -n $id ]] || continue
    if [[ $mode == "off" ]]; then
      verdict="available"
    elif entry_blocked "$id" "$mode"; then
      verdict="blocked"
      if [[ -n $program ]]; then
        sharer=$(awk -F '\t' -v p="$program" -v me="$id" '$3 == p && $1 != me { print $2 }' <<<"$entries" | while read -r other_name; do
          other_id=$(awk -F '\t' -v n="$other_name" '$2 == n { print $1; exit }' <<<"$entries")
          entry_blocked "$other_id" "$mode" || printf '%s\n' "$other_name"
        done | head -n 1)
        [[ -n $sharer ]] && verdict="hidden, program shared with $sharer"
      fi
    else
      verdict="allowed"
    fi
    printf '  %-30s %-30s %s\n' "$name" "$id" "$verdict"
  done <<<"$entries"
}

turn_on() {
  local mode="$1"
  document_key
  conf_set apps "$mode"
  ensure_lists
  if [[ $mode == "allowlist" && $(list_count "$ALLOW_FILE") == 0 ]]; then
    seed_allow_list
  fi
  install_hook
  apply_lists
  status
}

# apply, from the install leaf, the pacman hook, and the parent after a hand
# edit: the lists as the settings say, and the hook in place while on.
apply_now() {
  document_key
  ensure_lists
  if [[ $(apps_mode) == "off" ]]; then
    rm -f "$HOOK_DIR/$HOOK"
  else
    install_hook
  fi
  apply_lists
}

turn_off() {
  document_key
  conf_set apps off
  restore_all
  rm -f "$HOOK_DIR/$HOOK"
  echo "Apps: every app is available again. The lists in $PARENT_ETC are kept."
}

edit_lists() {
  local verb="$1" word id
  shift
  (($#)) || fail "$verb takes at least one app"
  ensure_lists
  for word in "$@"; do
    id=$(resolve_app "$word")
    case "$verb" in
      allow)
        list_drop "$DENY_FILE" "$id"
        list_add "$ALLOW_FILE" "$id"
        echo "Allowed $id."
        ;;
      deny)
        list_drop "$ALLOW_FILE" "$id"
        list_add "$DENY_FILE" "$id"
        echo "Denied $id."
        ;;
      remove)
        list_drop "$ALLOW_FILE" "$id"
        list_drop "$DENY_FILE" "$id"
        echo "Removed $id from both lists."
        ;;
    esac
  done
  apply_lists
}

# --- end apps ---

command="${1:-status}"
(($#)) && shift

require_child_install

case "$command" in
  status)
    status
    ;;
  list)
    show_list
    ;;
  denylist|allowlist)
    turn_on "$command"
    ;;
  off)
    turn_off
    ;;
  allow|deny|remove)
    edit_lists "$command" "$@"
    ;;
  apply)
    apply_now
    if [[ ${1:-} == "--quiet" ]]; then
      # The pacman hook's run: pacman prints a failure for any non-zero exit,
      # so a run that found nothing to change must still end with success.
      if (( CHANGED )); then
        echo "Parent's app list re-applied."
      fi
    else
      status
    fi
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 1
    ;;
esac
