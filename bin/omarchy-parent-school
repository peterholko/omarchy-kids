#!/bin/bash
# omarchy:summary=School and free time, independently of screen-time limits
# omarchy:args=<on|off|status|mode|schedule|apps> [VALUE ...] [--user NAME]
# omarchy:requires-sudo=true

set -euo pipefail
usage() {
  echo 'Usage: omarchy parent school <on|off|status|mode [school|free|auto]|schedule [DAYS HH:MM-HH:MM ...|off]|apps [add|remove ID ...]> [--user NAME]'
}
if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then usage; exit 0; fi
if (( EUID != 0 )); then exec sudo env OMARCHY_PATH="$OMARCHY_PATH" "$0" "$@"; fi
CONFIG="${OMARCHY_PARENT_SCHOOL_CONFIG:-/etc/omarchy/parent/school-mode.json}"
CLIENT="$OMARCHY_PATH/bin/omarchy-parent-school-client"
STATE_ROOT="${OMARCHY_PARENT_STATE_DIR:-/var/lib/omarchy/parent}"
SYSTEM_UNIT_DIR="${OMARCHY_SYSTEM_UNIT_DIR:-/etc/systemd/system}"
UNIT=omarchy-parent-timed.service
USER_NAME=""
fail() { echo "Error: $1" >&2; exit 1; }
source "$OMARCHY_PATH/lib/parent/omarchy_parent/core/parent.sh"
source "$OMARCHY_PATH/lib/parent/omarchy_parent/core/schedule.sh"
require_child_install() { omarchy-profile-child || fail "school mode needs a child install"; }
systemd_running() { [[ -d /run/systemd/system ]] && ! systemd-detect-virt --quiet --chroot 2>/dev/null; }
client() {
  "$CLIENT" --user "$USER_NAME" "$@"
}

client_ok() {
  local out
  out=$(client "$@" 2>/dev/null) || { echo "$out" | jq -r '"Error: " + (.error // "the parent daemon refused")' >&2 2>/dev/null || echo "Error: the parent daemon did not answer" >&2; return 1; }
  printf '%s\n' "$out"
}

daemon_up() {
  "$CLIENT" ping >/dev/null 2>&1
}

wait_daemon() {
  local i
  for i in $(seq 1 50); do
    daemon_up && return 0
    sleep 0.1
  done
  return 1
}

config_init() {
  [[ -f $CONFIG ]] && return 0
  install -d -m 0755 "$(dirname "$CONFIG")"
  printf '{"version": 1, "active_profile": "default", "profiles": {"default": {}}, "users": {}}\n' >"$CONFIG.tmp"
  chmod 0600 "$CONFIG.tmp"
  mv -f "$CONFIG.tmp" "$CONFIG"
}

# The school profile and its own periods.
profile_json() {
  client config get | jq -c --arg u "$USER_NAME" '.config as $c | $c.profiles[$c.users[$u].profile // $u] // $c.profiles[$c.active_profile] // {}'
}

patch() {
  client_ok config patch "$1" >/dev/null
}

ensure_bar_pill() {
  local home
  home=$(getent passwd "$USER_NAME" | cut -d: -f6)
  [[ -n $home && -d $home ]] || return 0
  runuser -u "$USER_NAME" -- env OMARCHY_PATH="$OMARCHY_PATH" HOME="$home" bash -c '
    source "$OMARCHY_PATH/bin/omarchy-shell-config"
    commit "$NORMALIZE
      | if any(.bar.layout[][]; (if type == \"object\" then .id else . end) == \"omarchy.school-mode\") then . else .bar.layout.left = [{\"id\": \"omarchy.school-mode\"}] + .bar.layout.left end
"
  ' >/dev/null 2>&1 || echo "Could not put the school-mode button on $USER_NAME's bar; as $USER_NAME, run: omarchy bar put omarchy.school-mode --section left" >&2
}

# The design before the daemon left a timer, a guard, and a sudo grant.
school_on() {
  config_init
  install -Dm644 "$OMARCHY_PATH/default/parent/$UNIT" "$SYSTEM_UNIT_DIR/$UNIT"
  if systemd_running; then
    systemctl daemon-reload
    systemctl enable --now "$UNIT" >/dev/null
    wait_daemon || fail "the parent daemon did not start. The journal says:
$(journalctl -u "$UNIT" -n 12 --no-pager 2>/dev/null | tail -n 12)"
    client_ok users add "$USER_NAME" >/dev/null
  else
    systemctl enable "$UNIT" >/dev/null 2>&1 || true
    # No daemon to ask in the chroot: name the account in the config it will read.
    jq --arg u "$USER_NAME" '.users[$u] = {"profile": $u} | .profiles[$u] = (.profiles[$u] // .profiles[.active_profile] // {}) | .profiles[$u].name = $u' "$CONFIG" >"$CONFIG.tmp"
    chmod 0600 "$CONFIG.tmp"
    mv -f "$CONFIG.tmp" "$CONFIG"
  fi
  ensure_bar_pill
  echo "School mode is on for $USER_NAME."
  systemd_running && client --human status || true
}

school_off() {
  if systemd_running && ! daemon_up; then
    systemctl start "$UNIT"
    wait_daemon || fail "the parent daemon must respond before disabling a module"
  fi
  if daemon_up; then
    client_ok users remove "$USER_NAME" >/dev/null
    if [[ $(client ping | jq -r '[.modules[].users] | add // 0') == 0 ]]; then
      systemctl disable --now "$UNIT" >/dev/null 2>&1 || true
    fi
  else
    "$OMARCHY_PATH/bin/omarchy-parent-files" disable "$CONFIG" "$USER_NAME" "$STATE_ROOT/$USER_NAME/school-mode/status.json"
  fi

  echo "School mode is off for $USER_NAME. The days and the settings are kept."
}

replace_periods() {
  local label=$1 mode=$2 new=$3 current
  current=$(profile_json | jq -c '.blocked_periods // []')
  patch "$(jq -nc --argjson current "$current" --argjson new "$new" --arg label "$label" --arg mode "$mode" \
    '{blocked_periods: ([$current[] | select(.label != $label or .mode != $mode)] + $new)}')"
}

show_periods() {
  profile_json | jq -r '.blocked_periods[]? | select(.enabled) | "  " + (if .mode == "free" then "school time" else "locked" end) + "  " + .label + "  " + (.days | join(" ")) + "  " + .start + "-" + .end'
}

school_schedule() {
  local days window start end entries="[]"
  if (( $# == 0 )); then
    echo "Periods for $USER_NAME:"
    show_periods
    return 0
  fi
  if [[ $1 == off ]]; then
    replace_periods School free '[]'
    echo "School hours cleared for $USER_NAME."
    return 0
  fi
  (( $# % 2 == 0 )) || fail "school schedule takes day and time pairs, like: mon-fri 08:00-15:30"
  while (( $# )); do
    days=$(days_json "$1") || fail "unknown days: $1 (use mon-fri, mon,wed,fri, weekdays, weekends, or daily)"
    read -r start end <<<"$(window_parts "$2")" || fail "bad time window: $2 (use HH:MM-HH:MM)"
    [[ -n ${end:-} ]] || fail "bad time window: $2 (use HH:MM-HH:MM)"
    entries=$(jq -c --argjson days "$days" --arg start "$start" --arg end "$end" '. + [{"label": "School", "enabled": true, "start": $start, "end": $end, "days": $days, "mode": "free"}]' <<<"$entries")
    shift 2
  done
  replace_periods School free "$entries"
  echo "School hours for $USER_NAME, not screen time:"
  show_periods
}

school_command() {
  local value=${2:-}
  case "${1:-status}" in
    on) school_on ;;
    off) school_off ;;
    status) client --human status ;;
    mode) client --human mode ${value:+"$value"} ;;
    schedule) shift; school_schedule "$@" ;;
    apps)
      local verb=${2:-} ids
      shift; (( $# )) && shift
      case $verb in
        "")
          echo "School mode shows these apps for $USER_NAME:"
          profile_json | jq -r '.school_apps[]? | "  " + .'
          ;;
        add|remove)
          (( $# )) || fail "time school-apps $verb needs desktop ids, as the launcher names them (obsidian, org.gnome.Nautilus)"
          ids=$(printf '%s\n' "$@" | jq -R . | jq -sc .)
          if [[ $verb == add ]]; then
            patch "$(profile_json | jq -c --argjson ids "$ids" '{school_apps: ((.school_apps // []) + $ids | unique)}')"
          else
            patch "$(profile_json | jq -c --argjson ids "$ids" '{school_apps: [(.school_apps // [])[] | select(. as $a | $ids | index($a) | not)]}')"
          fi
          echo "School mode now shows these apps for $USER_NAME:"
          profile_json | jq -r '.school_apps[]? | "  " + .'
          ;;
        *) fail "time school-apps takes add or remove, then desktop ids" ;;
      esac
      ;;
    *) usage >&2; return 1 ;;
  esac
}
user=""
positional=()
while (($#)); do
  case "$1" in
    --user)
      user="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done

require_child_install
[[ -n $user ]] || user="${SUDO_USER:-}"
[[ -n $user ]] || fail "time needs --user NAME, or to run through sudo from the kid's session"
[[ $user != "root" ]] || fail "the kid account cannot be root"
getent passwd "$user" >/dev/null || fail "user '$user' does not exist"
USER_NAME=$user
(( ${#positional[@]} >= 1 )) || { usage >&2; exit 1; }
school_command "${positional[@]}"
