#!/bin/bash

# omarchy:summary=Screen time earned with arithmetic
# omarchy:args=<status|on|off|earn|questions|rate|level|cap|budget|grant|pause|resume|lock|school|bedtime|mode|school-apps|report|history> [VALUE ...] [--user NAME]
# omarchy:examples=sudo omarchy-parent time on | sudo omarchy-parent time earn 10 30 | sudo omarchy-parent time grant 30 | sudo omarchy-parent time school mon-fri 08:00-15:30
# omarchy:requires-sudo=true

# The parent's controls for screen time (plans/kids-screen-time.md), reached
# as `omarchy-parent time ...`: omarchy-parent hands every feature subcommand
# to the matching omarchy-parent-<feature>. The counting, the warnings, the
# lock, and the crediting live in omarchy-parent-timed, a root daemon
# (lib/screen-time); this switches it on for an account, tunes its profile
# through the client, and reports. Root over the socket needs no password:
# sudo has already asked the parent for it.
#
# Runs as root; a bare invocation re-execs itself under sudo, whose prompt is
# the parent password itself, forwarding the caller's gum theme vars.

set -euo pipefail

usage() {
  cat <<USAGE
Usage: omarchy-parent time <status|on|off|report [YYYY-MM-DD]|history> [--user NAME]
       omarchy-parent time earn QUESTIONS MINUTES [--user NAME]
       omarchy-parent time questions COUNT [--user NAME]
       omarchy-parent time rate MINUTES [--user NAME]
       omarchy-parent time level <grade1|grade2|grade3|grade4|grade5|grade6> [--user NAME]
       omarchy-parent time cap MINUTES [--user NAME]
       omarchy-parent time budget MINUTES [DAYS] [--user NAME]
       omarchy-parent time <grant MINUTES|pause|resume|lock> [--user NAME]
       omarchy-parent time school [DAYS HH:MM-HH:MM ...|off] [--user NAME]
       omarchy-parent time bedtime [HH:MM-HH:MM|off] [--user NAME]
       omarchy-parent time mode [school|free|auto] [--user NAME]
       omarchy-parent time school-apps [add|remove ID ...] [--user NAME]

on and off switch screen time for the kid account. Her day starts with the
budget for that weekday (default 60 minutes, 90 at the weekend), it counts down
while the screen is unlocked and she is at it, she is warned at 15, 5, and 1
minutes, and at zero the screen locks 10 seconds later. She unlocks with her own
password and Math time opens full screen: a set of QUESTIONS questions at the
grade level (default 10 at grade5) earns MINUTES minutes (default 30) when
every answer is right, each right answer worth its share, up to cap minutes a
day (default 120). Math time may stay open for the whole set; if it is missing
or closed while no time has been earned, the screen locks again after a minute.
Unlocking with the parent password adds five minutes instead.

earn sets that ratio; questions changes the count and keeps the minutes; rate
is the old way round, minutes per right answer. budget sets the day's minutes,
for every day or for DAYS (mon-fri, weekends, sat, daily). grant banks time
outright; the bank and negative grants stop at zero. pause stops the countdown
until resume, lock locks her screen now.
bedtime locks the screen between two times every night. School scheduling,
mode selection, and school apps belong to the separately installed school
module; the old time school/mode/school-apps commands forward to it.
status reports the current budget; report prints a day's use and earnings,
and history reports the last two weeks.
USAGE
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

case "${1:-}" in
  school) shift; exec "$OMARCHY_PATH/bin/omarchy-parent-school" schedule "$@" ;;
  mode) shift; exec "$OMARCHY_PATH/bin/omarchy-parent-school" mode "$@" ;;
  school-apps) shift; exec "$OMARCHY_PATH/bin/omarchy-parent-school" apps "$@" ;;
esac

if (( EUID != 0 )); then
  mapfile -t gum_env < <(env | grep '^GUM_' || true)
  exec sudo env OMARCHY_PATH="$OMARCHY_PATH" "${gum_env[@]}" "$0" "$@"
fi

CONFIG="${OMARCHY_PARENT_TIME_CONFIG:-/etc/omarchy/parent/screen-time.json}"
CLIENT="${OMARCHY_PARENT_TIME_CLIENT:-$OMARCHY_PATH/bin/omarchy-parent-time-client}"
STATE_ROOT="${OMARCHY_PARENT_STATE_DIR:-/var/lib/omarchy/parent}"
SYSTEM_UNIT_DIR="${OMARCHY_SYSTEM_UNIT_DIR:-/etc/systemd/system}"
UNIT=omarchy-parent-timed.service
USER_NAME=""

fail() {
  echo "Error: $1" >&2
  exit 1
}

# SUDOERS_DIR, for taking the old design's grant away.
source "$OMARCHY_PATH/install/helpers/parent.sh"

require_child_install() {
  omarchy-profile-child || fail "this is not a child install; screen time only applies to the kids mode profile"
}

# The install chroot sees the live system's /run; only a booted system outside
# a chroot can take --now, or has a daemon to talk to.
systemd_running() {
  [[ -d /run/systemd/system ]] && ! systemd-detect-virt --quiet --chroot 2>/dev/null
}

# --- screen time ---
# Everything goes through the client as root, naming the account.

client() {
  "$CLIENT" --user "$USER_NAME" "$@"
}

client_ok() {
  local out
  out=$(client "$@" 2>/dev/null) || { echo "$out" | jq -r '"Error: " + (.error // "the screen-time daemon refused")' >&2 2>/dev/null || echo "Error: the screen-time daemon did not answer" >&2; return 1; }
  printf '%s\n' "$out"
}

daemon_up() {
  "$CLIENT" ping >/dev/null 2>&1
}

wait_daemon() {
  local i
  for i in $(seq 1 50); do
    daemon_up && return 0
    sleep 0.1
  done
  return 1
}

config_init() {
  [[ -f $CONFIG ]] && return 0
  install -d -m 0755 "$(dirname "$CONFIG")"
  printf '{"version": 3, "active_profile": "default", "profiles": {"default": {}}, "users": {}}\n' >"$CONFIG.tmp"
  chmod 0600 "$CONFIG.tmp"
  mv -f "$CONFIG.tmp" "$CONFIG"
}

# The profile's earning knobs and periods as the daemon holds them.
profile_json() {
  client config get | jq -c --arg u "$USER_NAME" '.config as $c | $c.profiles[$c.users[$u].profile // $u] // $c.profiles[$c.active_profile] // {}'
}

patch() {
  client_ok config patch "$1" >/dev/null
}

set_worth() {
  local q m s
  q=$(profile_json | jq -r '.earn.questions_per_set // 10')
  m=$(profile_json | jq -r '.earn.set_minutes // 30')
  s=$(( m * 60 / q ))
  if (( s % 60 == 0 )); then printf '%s min' $(( s / 60 ))
  elif (( s < 60 )); then printf '%s s' "$s"
  else printf '%s min %s s' $(( s / 60 )) $(( s % 60 ))
  fi
}

# The pill on the kid's bar, once: the shell config is hers, so the edit is
# made as her, through the shell's own config helper.
ensure_bar_pill() {
  local home
  home=$(getent passwd "$USER_NAME" | cut -d: -f6)
  [[ -n $home && -d $home ]] || return 0
  runuser -u "$USER_NAME" -- env OMARCHY_PATH="$OMARCHY_PATH" HOME="$home" bash -c '
    source "$OMARCHY_PATH/bin/omarchy-shell-config"
    commit "$NORMALIZE
      | if any(.bar.layout[][]; (if type == \"object\" then .id else . end) == \"omarchy.screen-time\") then . else .bar.layout.right = [{\"id\": \"omarchy.screen-time\"}] + .bar.layout.right end
"
  ' >/dev/null 2>&1 || echo "Could not put the screen-time pill on $USER_NAME's bar; as $USER_NAME, run: omarchy bar put omarchy.screen-time --section right" >&2
}

# The design before the daemon left a timer, a guard, and a sudo grant.
remove_legacy() {
  local unit
  for unit in omarchy-parent-time.timer omarchy-parent-time-guard.service; do
    if [[ -f $SYSTEM_UNIT_DIR/$unit ]]; then
      if systemd_running; then systemctl disable --now "$unit" >/dev/null 2>&1 || true
      else systemctl disable "$unit" >/dev/null 2>&1 || true; fi
    fi
  done
  rm -f "$SYSTEM_UNIT_DIR/omarchy-parent-time.service" "$SYSTEM_UNIT_DIR/omarchy-parent-time.timer" "$SYSTEM_UNIT_DIR/omarchy-parent-time-guard.service"
  rm -f "$SUDOERS_DIR/omarchy-parent-$USER_NAME-time" "$SUDOERS_DIR/omarchy-parent-time-$USER_NAME"
}

time_on() {
  config_init
  install -Dm644 "$OMARCHY_PATH/default/parent/$UNIT" "$SYSTEM_UNIT_DIR/$UNIT"
  if systemd_running; then
    systemctl daemon-reload
    systemctl enable --now "$UNIT" >/dev/null
    wait_daemon || fail "the screen-time daemon did not start. The journal says:
$(journalctl -u "$UNIT" -n 12 --no-pager 2>/dev/null | tail -n 12)"
    client_ok users add "$USER_NAME" >/dev/null
  else
    systemctl enable "$UNIT" >/dev/null 2>&1 || true
    # No daemon to ask in the chroot: name the account in the config it will read.
    jq --arg u "$USER_NAME" '.users[$u] = {"profile": $u} | .profiles[$u] = (.profiles[$u] // .profiles[.active_profile] // {}) | .profiles[$u].name = $u' "$CONFIG" >"$CONFIG.tmp"
    chmod 0600 "$CONFIG.tmp"
    mv -f "$CONFIG.tmp" "$CONFIG"
  fi
  remove_legacy
  ensure_bar_pill
  echo "Screen time is on for $USER_NAME."
  systemd_running && client --human status || true
}

time_off() {
  if systemd_running && ! daemon_up; then
    systemctl start "$UNIT"
    wait_daemon || fail "the parent daemon must respond before disabling a module"
  fi
  if daemon_up; then
    client_ok users remove "$USER_NAME" >/dev/null
    if [[ $(client ping | jq -r '[.modules[].users] | add // 0') == 0 ]]; then
      systemctl disable --now "$UNIT" >/dev/null 2>&1 || true
    fi
  else
    "$OMARCHY_PATH/bin/omarchy-parent-files" disable "$CONFIG" "$USER_NAME" "$STATE_ROOT/$USER_NAME/time/status.json"
  fi
  echo "Screen time is off for $USER_NAME. The days and the settings are kept."
}

source "$OMARCHY_PATH/lib/parent/omarchy_parent/core/schedule.sh"

# Replace the periods with a label and mode by new ones, keeping the rest.
replace_periods() {
  local label=$1 mode=$2 new=$3 current
  current=$(profile_json | jq -c '.blocked_periods // []')
  patch "$(jq -nc --argjson current "$current" --argjson new "$new" --arg label "$label" --arg mode "$mode" \
    '{blocked_periods: ([$current[] | select(.label != $label or .mode != $mode)] + $new)}')"
}

show_periods() {
  profile_json | jq -r '.blocked_periods[]? | select(.enabled) | "  " + (if .mode == "free" then "school time" else "locked" end) + "  " + .label + "  " + (.days | join(" ")) + "  " + .start + "-" + .end'
}

time_bedtime() {
  local start end
  if (( $# == 0 )); then
    echo "Periods for $USER_NAME:"
    show_periods
    return 0
  fi
  if [[ $1 == off ]]; then
    replace_periods Bedtime block '[]'
    echo "Bedtime cleared for $USER_NAME."
    return 0
  fi
  read -r start end <<<"$(window_parts "$1")" || fail "bad time window: $1 (use HH:MM-HH:MM, like 20:00-07:00)"
  [[ -n ${end:-} ]] || fail "bad time window: $1 (use HH:MM-HH:MM, like 20:00-07:00)"
  replace_periods Bedtime block "$(jq -nc --arg start "$start" --arg end "$end" '[{"label": "Bedtime", "enabled": true, "start": $start, "end": $end, "days": ["mon","tue","wed","thu","fri","sat","sun"], "mode": "block"}]')"
  echo "Bedtime for $USER_NAME: the screen locks from $start to $end."
}

time_command() {
  local action=${1:-} value=${2:-}
  case $action in
    on) time_on; return ;;
    off) time_off; return ;;
  esac
  [[ $action == status || $action == report || $action == history ]] || [[ -f $CONFIG ]] || fail "screen time is not set up for $USER_NAME; run omarchy-parent time on first"
  case $action in
    status) client --human status ;;
    report|log) client --human day ${value:+"$value"} ;;
    history) client --human history --days "${value:-14}" ;;
    earn)
      local minutes=${3:-}
      [[ $value =~ ^[0-9]+$ ]] && (( value >= 1 && value <= 50 )) || fail "time earn needs a count of questions from 1 to 50, then the minutes the set earns"
      [[ $minutes =~ ^[0-9]+$ ]] && (( minutes >= 1 && minutes <= 600 )) || fail "time earn needs the minutes a set earns, from 1 to 600"
      patch "$(jq -nc --argjson q "$value" --argjson m "$minutes" '{earn: {questions_per_set: $q, set_minutes: $m}}')"
      echo "A set is now $value questions earning $minutes minutes for $USER_NAME: $(set_worth) per right answer."
      ;;
    questions)
      [[ $value =~ ^[0-9]+$ ]] && (( value >= 1 && value <= 50 )) || fail "time questions needs a count from 1 to 50"
      patch "$(jq -nc --argjson q "$value" '{earn: {questions_per_set: $q}}')"
      echo "A set is now $value questions for $USER_NAME, still earning $(profile_json | jq -r '.earn.set_minutes') minutes: $(set_worth) per right answer."
      ;;
    rate)
      [[ $value =~ ^[0-9]+$ ]] && (( value >= 1 )) || fail "time rate needs a number of minutes per right answer"
      local q; q=$(profile_json | jq -r '.earn.questions_per_set // 10')
      patch "$(jq -nc --argjson m $(( value * q )) '{earn: {set_minutes: $m}}')"
      echo "Each right answer is now worth $value minutes for $USER_NAME: a set of $q earns $(( value * q ))."
      ;;
    level)
      [[ $value =~ ^grade[1-6]$ ]] || fail "time level needs one of grade1 to grade6"
      patch "$(jq -nc --arg l "$value" '{earn: {level: $l}}')"
      echo "Earning questions are now at $value for $USER_NAME."
      ;;
    cap)
      [[ $value =~ ^[0-9]+$ ]] || fail "time cap needs a number of minutes"
      patch "$(jq -nc --argjson c "$value" '{earn: {daily_cap_minutes: $c}}')"
      echo "$USER_NAME can now earn up to $value minutes a day."
      ;;
    budget|free)
      [[ $value =~ ^[0-9]+$ ]] || fail "time budget needs a number of minutes, then optionally the days"
      local days; days=$(days_json "${3:-daily}") || fail "unknown days: ${3:-} (use mon-fri, weekends, sat, or daily)"
      patch "$(jq -nc --argjson m "$value" --argjson days "$days" '{budget_minutes: ([$days[] | {key: ., value: $m}] | from_entries)}')"
      echo "$USER_NAME's day starts with $value minutes on $(jq -r 'join(", ")' <<<"$days")."
      ;;
    grant)
      [[ $value =~ ^-?[0-9]+$ ]] || fail "time grant needs a number of minutes"
      echo "Granted $value minutes; $USER_NAME now has $(client_ok grant "$value" | jq -r '(.remaining_seconds // 0) / 60 | ceil') minutes left today."
      ;;
    pause) client_ok pause >/dev/null; echo "Screen time is paused for $USER_NAME until resume." ;;
    resume) client_ok resume >/dev/null; echo "Screen time counts again for $USER_NAME." ;;
    lock) client_ok lock >/dev/null; echo "Locked $USER_NAME's screen." ;;
    bedtime) shift; time_bedtime "$@" ;;
    *) usage >&2; exit 1 ;;
  esac
}
# --- end screen time ---

user=""
positional=()
while (($#)); do
  case "$1" in
    --user)
      user="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done

require_child_install
[[ -n $user ]] || user="${SUDO_USER:-}"
[[ -n $user ]] || fail "time needs --user NAME, or to run through sudo from the kid's session"
[[ $user != "root" ]] || fail "the kid account cannot be root"
getent passwd "$user" >/dev/null || fail "user '$user' does not exist"
USER_NAME=$user
(( ${#positional[@]} >= 1 )) || { usage >&2; exit 1; }
time_command "${positional[@]}"
