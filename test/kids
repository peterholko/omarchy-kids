#!/bin/bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
export OMARCHY_PATH="$root"
python3 -m unittest discover -s test/parent -v
for suite in parent parent-unlock parent-plugin parent-time parent-school parent-dns parent-browsing screen-time-daemon screen-time-plugin school-mode-plugin math-plugin; do
  bash "test/shell.d/$suite-test.sh"
done
